  "structures": [
    {
      "id": "no-es-solo",
      "regex": "(?i)\\bno es (?:solo|sólo|solamente|simplemente) [^.!?\\n]{2,60}[,.;] (?:es|sino)\\b",
      "name": "\"No es solo X, es Y\"",
      "fix": "Di la única cosa que quieres decir. Borra la mitad que prepara el terreno."
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno solo\\b[^.!?\\n]{2,80}\\bsino (?:también|que)\\b",
      "name": "\"No solo X, sino también Y\"",
      "fix": "Pártelo en dos frases o quita la mitad más floja."
    },
    {
      "id": "no-se-trata",
      "regex": "(?i)\\bno se trata (?:solo |sólo |solamente )?de [^.!?\\n]{2,60}[,.;] se trata de\\b",
      "name": "\"No se trata de X. Se trata de Y.\"",
      "fix": "Empieza por Y. El giro es lo que delata."
    },
    {
      "id": "el-resultado",
      "regex": "(?im)^\\s*¿?(?:el resultado|lo mejor|lo mejor de todo|la clave|el truco|lo peor|la trampa|el problema|la respuesta)\\?\\s*$",
      "name": "Pregunta retórica de una línea (\"¿El resultado?\")",
      "fix": "Dilo en la misma frase en vez de escenificar la revelación."
    },
    {
      "id": "esto-aprendi",
      "regex": "(?i)\\b(?:esto es lo que|te cuento lo que|lo que) (?:he aprendido|aprendí)\\b",
      "name": "\"Esto es lo que aprendí\"",
      "fix": "Di la lección. Sáltate el anuncio."
    },
    {
      "id": "triada",
      "regex": "(?i)\\b[^\\W\\d_]+, [^\\W\\d_]+ (?:y|e) [^\\W\\d_]+\\.",
      "name": "Tríada (regla de tres)",
      "fix": "Dos cosas o cuatro. Tres es el ritmo por defecto del modelo."
    },
    {
      "id": "cohete",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de cohete / fuego / bombilla / destellos / diana",
      "fix": "Un emoji como mucho, y que no sea uno de estos cinco."
    },
    {
      "id": "muro-hashtags",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Muro de hashtags (6+)",
      "fix": "Instagram los limita a cinco por publicación desde diciembre de 2025. Tres bien elegidos."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:una )?ia\\b|\\bcomo (?:un )?modelo de lenguaje\\b",
      "name": "El modelo hablando de sí mismo",
      "fix": "Borra la frase."
    },
    {
      "id": "en-resumen",
      "regex": "(?im)^\\s*(?:en resumen|en conclusión|para concluir|en definitiva|para resumir)\\b",
      "name": "Apertura de cierre de redacción",
      "fix": "Un post no necesita un párrafo de conclusiones."
    },
    {
      "id": "cebo-respuesta",
      "regex": "(?i)¿(?:estás de acuerdo|qué opinas|qué piensas|me equivoco|quién más)[^?\\n]*\\?\\s*$",
      "name": "Cebo de interacción reflejo",
      "fix": "Haz una pregunta que solo tú podrías hacer, sobre lo concreto que acabas de contar."
    },
    {
      "id": "deja-scroll",
      "regex": "(?im)^\\s*(?:deja de (?:hacer scroll|scrollear|bajar)|para de hacer scroll|no hagas scroll|no sigas bajando|espera,? no (?:pases|sigas))\\b",
      "name": "Apertura \"deja de hacer scroll\"",
      "fix": "Lo que frena el scroll tiene que ser la afirmación misma. Pedir atención delata que no te la has ganado."
    },
    {
      "id": "en-este-video",
      "regex": "(?i)\\b(?:en (?:este|el) (?:vídeo|video|reel|post)(?: de hoy)?|hoy te voy a (?:enseñar|mostrar|contar)|te voy a (?:enseñar|mostrar) (?:cómo|como))\\b",
      "name": "Preámbulo de vídeo (\"en este vídeo te voy a enseñar\")",
      "fix": "Bórralo y empieza por la recompensa. Los dos primeros segundos deciden el reel entero."
    },
    {
      "id": "emoji-vinetas",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Lista con emojis como viñetas",
      "fix": "Usa un guion o un salto de línea. Las viñetas con emoji es lo más de plantilla que hay en un caption."
    },
    {
      "id": "gritos",
      "regex": "\\b[A-ZÁÉÍÓÚÑÜ]{3,}\\b(?:\\s+\\b[A-ZÁÉÍÓÚÑÜ]{3,}\\b){2,}",
      "name": "Tres o más palabras gritadas seguidas",
      "fix": "Las mayúsculas son un control de volumen, no un subrayador. Una palabra, como mucho."
    },
    {
      "id": "cebo-seguir",
      "regex": "(?i)\\b(?:sígueme para|etiqueta a alguien|menciona a alguien|dale (?:doble tap|like) si|comparte esto si|comenta si)\\b",
      "name": "Cebo reflejo de seguir o etiquetar",
      "fix": "Pide la única acción que este post se gana. La petición genérica enseña al público a ignorar todas."
    },
    {
      "id": "aduladora",
      "regex": "(?im)^\\s*¡(?:claro|por supuesto|excelente|genial|qué buena pregunta)[^!\\n]{0,40}!",
      "name": "Apertura servicial (\"¡Claro!\", \"¡Excelente pregunta!\")",
      "fix": "Es la voz de un asistente, no la tuya. Empieza por lo que tienes que decir."
    },
    {
      "id": "estas-listo",
      "regex": "(?i)¿(?:estás|estáis|está usted) (?:list[oa]s?|preparad[oa]s?) para\\b",
      "name": "\"¿Estás listo para...?\"",
      "fix": "Nadie contesta que sí en voz alta. Di qué pasa después y punto."
    },
    {
      "id": "title-case",
      "regex": "(?m)^\\s*(?:[A-ZÁÉÍÓÚÑ][a-záéíóúñü]+\\s+){3,}[A-ZÁÉÍÓÚÑ][a-záéíóúñü]+",
      "name": "Mayúsculas a la inglesa (\"Cómo Escribir Un Caption Que Vende\")",
      "fix": "En español solo va en mayúscula la primera palabra y los nombres propios. Esto huele a traducción."
    }
  ]
}